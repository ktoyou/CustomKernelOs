#!/bin/sh
# Ответы пресета libcurl 8.23.0: HTTP/HTTPS/WS, OpenSSL, zlib, /include и /lib.
ver=8.23.0

field() {
    printf '%s\n' "$1" | cut -d. -f"$2"
}

usage() {
    echo "Usage: curl-config [OPTION]"
    echo
    echo "Available values for OPTION include:"
    echo
    echo "  --built-shared        says 'yes' if libcurl was built shared"
    echo "  --ca                  CA bundle install path"
    echo "  --cc                  compiler"
    echo "  --cflags              preprocessor and compiler flags"
    echo "  --checkfor [version]  check for (lib)curl of the specified version"
    echo "  --configure           the arguments given to configure when building curl"
    echo "  --features            newline separated list of enabled features"
    echo "  --help                display this help and exit"
    echo "  --libs                library linking information"
    echo "  --prefix              curl install prefix"
    echo "  --protocols           newline separated list of enabled protocols"
    echo "  --ssl-backends        output the SSL backends libcurl was built to support"
    echo "  --static-libs         static libcurl library linking information"
    echo "  --version             output version information"
    echo "  --vernum              output version as a hexadecimal number"
    exit "$1"
}

checkfor() {
    cmaj=$(field "$1" 1)
    cmin=$(field "$1" 2)
    cpat=$(field "$1" 3)
    cpat=${cpat%%-*}
    vmaj=$(field "$ver" 1)
    vmin=$(field "$ver" 2)
    vpat=$(field "$ver" 3)
    if [ "$vmaj" -gt "$cmaj" ]; then exit 0; fi
    if [ "$vmaj" -eq "$cmaj" ]; then
        if [ "$vmin" -gt "$cmin" ]; then exit 0; fi
        if [ "$vmin" -eq "$cmin" ]; then
            if [ "$cpat" -le "$vpat" ]; then exit 0; fi
        fi
    fi
    echo "requested version $1 is newer than existing $ver" >&2
    exit 1
}

if [ $# -eq 0 ]; then
    usage 1
fi

while [ $# -gt 0 ]; do
    case "$1" in
    --built-shared) echo yes ;;
    --ca|--configure) echo ;;
    --cc) echo cc ;;
    --cflags) echo "-I/include" ;;
    --checkfor)
        shift
        if [ $# -eq 0 ]; then usage 1; fi
        checkfor "$1"
        ;;
    --feature|--features)
        echo HTTPS-proxy
        echo libz
        echo SSL
        ;;
    --help) usage 0 ;;
    --libs) echo "-L/lib -lcurl" ;;
    --prefix) echo / ;;
    --protocols)
        echo HTTP
        echo HTTPS
        echo WS
        echo WSS
        ;;
    --ssl-backends) echo OpenSSL ;;
    --static-libs)
        echo "curl was built with static libraries disabled" >&2
        exit 1
        ;;
    --version)
        echo "libcurl $ver"
        exit 0
        ;;
    --vernum)
        echo 081700
        exit 0
        ;;
    *)
        echo "unknown option: $1" >&2
        usage 1
        ;;
    esac
    shift
done
exit 0
